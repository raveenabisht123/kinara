# Kinara Health: project settings
# Copy to .env and fill in. Keep .env out of git.

# Google Apps Script Web app (lead store). Public: also set in config.js
KINARA_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Admin key that unlocks leads in admin.html. SECRET.
# Stored in Apps Script > Project Settings > Script properties > ADMIN_KEY
KINARA_ADMIN_KEY=your-admin-key

# Google Sheet that stores the leads
GOOGLE_SHEET_ID=your-sheet-id
APPS_SCRIPT_PROJECT_ID=your-script-project-id

# Live URLs
SITE_URL=https://raveenabisht123.github.io/kinara/
ADMIN_URL=https://raveenabisht123.github.io/kinara/admin.html
GITHUB_REPO=raveenabisht123/kinara

# Ad tracking (fill in, then ask Claude to add them to index.html and thank-you.html)
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=

# Clinic contact (currently sample values on the site)
CLINIC_NAME=Kinara Health
CLINIC_PHONE=+91 98765 43210
CLINIC_WHATSAPP=919876543210
CLINIC_EMAIL=care@kinarahealth.in
